rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 用戶文件：只允許本人讀寫
    // 注意：App Check (request.app != null) 已移除，因為客戶端尚未整合 App Check SDK。
    // API 安全性由 Cloud Functions 層的 enforceAppCheck 與 Firebase Auth 保護。
    match /users/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;

      // 點數紀錄：本人可讀、可新增（不可修改或刪除）
      // 客戶端負責 earned 記錄；Cloud Functions 負責 spent/refund 記錄
      match /creditHistory/{docId} {
        allow read, create: if request.auth != null
                            && request.auth.uid == uid;
      }
    }
  }
}
