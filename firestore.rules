rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 用戶文件：本人可讀；寫入不得異動 credits / updatedAt 欄位（由 Cloud Functions 控管）
    match /users/{uid} {
      allow read: if request.auth != null
                  && request.auth.uid == uid;

      // 允許 client 更新非金融欄位（例如 displayName、photoURL 等）
      // 明確禁止 client 觸碰 credits / updatedAt
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && !('credits' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('updatedAt' in request.resource.data.diff(resource.data).affectedKeys());

      // create 僅允許 Auth trigger 建立初始文件（沒有 credits 欄位時）
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && !('credits' in request.resource.data);

      // 點數紀錄：本人只讀；所有寫入僅允許 Cloud Functions
      match /creditHistory/{docId} {
        allow read: if request.auth != null
                    && request.auth.uid == uid;
        allow write: if false; // 僅 Cloud Functions 可寫
      }

      // 付費功能解鎖紀錄：本人只讀（寫入僅允許 Cloud Functions）
      match /purchases/{productId} {
        allow read: if request.auth != null
                    && request.auth.uid == uid;
        allow write: if false; // 僅 Cloud Functions 可寫
      }

      // 每日獎勵摘要：本人只讀（寫入僅允許 Cloud Functions）
      match /dailyRewardSummary/{dateKey} {
        allow read: if request.auth != null
                    && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // 挑戰碼：任何已登入用戶可讀（用於驗證 code）；寫入僅允許 Cloud Functions
    match /challenges/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 挑戰參與記錄：本人可讀自己的記錄；寫入僅允許 Cloud Functions
    match /challengeParticipants/{docId} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
